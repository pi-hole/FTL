root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{c,h}]
indent_style = tab
indent_size = 4

[*.{bats}]
indent_style = tab
indent_size = 4

[*.{json,js,md,conf,toml,txt,sql,svg}]
indent_style = space
indent_size = 2

# Vendored third-party code and generated files: do not enforce EditorConfig rules
# trim_trailing_whitespace is false rather than unset:
# explictly disable it for editors, rather than using their defaults
[src/dnsmasq/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset

[{src/lua/l*,src/lua/scripts/inspect.lua}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset

[src/tre-regex/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
indent_style = unset
